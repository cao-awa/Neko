locate com.github.kusa233.neko.sample.effect

class EffectRecovery {
    static {
        fun main(args: string[]) {
            nyanTest()
        }

        fun nyanTest() {
            offset: int = 3
            v: int = try a() { a, b ->
                if (a + b == 3) {
                    nyan (a + b) * offset // Should be (1 + 2) * 3
                } else {
                    yield 10 // v should be 10 if a + b not 3
                }
            }
            println(v)
        }

        fun a(): int {
            return b() // Recovery to here, return 90 directly
        } emit [int, int] -> int

        fun b(): int {
            v: int = scratch 1, 2
            println(v)
            return v * 10 // Should be 9 * 10
        } emit [int, int] -> int
    }
}
