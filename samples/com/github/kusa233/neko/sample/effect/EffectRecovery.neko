locate com.github.kusa233.neko.sample.effect

/**
 * The reference for `try ... { ... }`, `scratch` and `nyan`.
 *
 * `nyanTest` declares the handler; `b` reaches it from two calls down. The `try` compiles its
 * `{ ... }` block into a method on this class, and every `scratch` with a matching emit signature
 * calls that method instead of raising anything. `nyan` returns a value from it; `yield` throws an
 * `EmitYieldException` that the `try` catches and stores into its target.
 *
 * Each `emit` clause names its result after `-> int`: the handler answers an `int`, which is what
 * the `scratch` site is worth, and a valued `nyan` here has to produce one.
 */
class EffectRecovery {
    static {
        fun main(args: string[]) {
            nyanTest()
        }

        fun nyanTest() {
            offset: int = 3
            v: int = try a() { a, b ->
                if (a + b == 3) {
                    nyan (a + b) * offset // Should be (1 + 2) * 3
                } else {
                    yield 10 // v should be 10 if a + b not 3
                }
            }
            println(v)
            retry: int = try a() { a, b ->
                nyan 10
            }
            println(retry)
        }

        fun a(): int {
            return b() // Recovery to here, return 30 directly
        } emit [int, int] -> int

        fun b(): int {
            v: int = scratch 1, 2
            println(v)
            return v * 10 // Should be 3 * 10
        } emit [int, int] -> int
    }
}
