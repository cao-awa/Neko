locate com.github.kusa233.neko.sample.instance

import java.util

class InstanceSample {
    static {
        fun main() {
            var1: Instance = Instance<int>(123)
            var2: Instance = Instance<int>(123)
            var3: Instance = Instance<int>(456)
            println(var1 == var2)
            println(var2 == var3)
            println(var1)

            methodGeneric<int>(123)

            // `::generic` reads back what the construction named. The type is erased from the
            // value's own signature, so this is the only way to see it at run time.
            var4: Instance = Instance<string>("hello")
            println(var1::generic[0]) // int
            println(var4::generic[0]) // class java.lang.String

            // The JDK was never compiled by this program, so there is no declaration to check
            // `add` against — reflection answers instead. The erased signature says `Object`,
            // which every value fits, so the *written* `int` is what the argument is held to:
            // `add("awa")` is refused here, and the `int` is boxed on the way in exactly as a
            // Java call site would.
            list: ArrayList<int> = ArrayList<int>()
            println(list.isEmpty())
            list.add(123)
            println(list)
            println(list.size()) // 1
            println(list.get(0)) // 123 — read back out of the list
            println(list::generic[0])
        }

        fun <T> methodGeneric(value: T) {
            println(value)
        }
    }
}

meow class Instance<T>(val data: T) {

}
