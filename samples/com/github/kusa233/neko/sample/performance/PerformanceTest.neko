locate com.github.kusa233.neko.sample.performance

import com.github.kusa233.neko.sample.exception.ExceptionMapping

class PerformanceTest {
    static {
        fun main() {
            start: long = System.currentTimeMillis()
            for (i: int = 0; i < 10000000; i++) {
                ExceptionMapping.main()
            }
            println("Test used time " + (System.currentTimeMillis() - start) + "ms")
        }
    }
}