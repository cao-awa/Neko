locate com.github.kusa233.neko.sample.assert

/**
 * `nya <condition>` — writes down what the program believes, and says what a wrong belief means.
 *
 * The construct exists because some facts are true of the program rather than of its input: a value
 * that must have been set up, a result that must obey the comment above it, an invariant that holds
 * when a loop ends. A `nya` writes that down where it is relied on, so a run that breaks the
 * assumption ends at the line that made it instead of somewhere later where the damage shows up.
 *
 * It has three forms, and the sample uses all of them:
 *
 *  * `nya condition` — a false condition throws `java.lang.AssertionError` naming the condition.
 *  * `nya condition { ... }` — the block runs on a false condition and the program carries on, which
 *    is how a failure that can be dealt with is dealt with. It is entered a second way too: an
 *    `AssertionError` thrown while the condition was evaluated. That is what makes `nya call() { ... }`
 *    a call whose failed checks are answered here, and it is why the condition does not have to be a
 *    `bool` when a block says what failing means.
 *  * `nya condition { ... } else { ... }` — worth a value, one block per outcome of the condition.
 *
 * Every check below that must hold does hold, so the program runs to the end. The cases that must not
 * compile are commented out, as the other samples do.
 */
class NyaSample() {
    static {
        fun main(args: string[]) {
            comparisons()
            functionCalls()
            narrowing()
            recovered()
            catching()
            valued()
            // Error to compile: only a 'bool' can be checked, because nothing else could fail.
            // nya 1 + 1
            // Not an error, though — with a block there is a throw to answer as well, so the
            // condition may be anything at all: nya 1 + 1 { }
        }

        // The condition is an ordinary expression, so a comparison is written the way it is written
        // anywhere else — there is no separate spelling for 'nya'.
        fun comparisons() {
            count: int = 3
            nya count > 0                    // Carries on: 3 is positive
            nya count == 3                   // Carries on
            println(count)                   // Should print '3'

            // A check on a value the program computed rather than one it was handed.
            total: int = count * 2
            nya total == 6
            println(total)                   // Should print '6'
        }

        // Anything that answers a 'bool' is a condition: a call, a variable, a chained comparison.
        fun functionCalls() {
            nya ready() {
                println("Not ready")
            }
            println("ready")                 // Should print 'ready'

            flag: bool = true
            nya flag
            println("flag")                  // Should print 'flag'
        }

        // A check that holds proves its condition for everything after it, so it doubles as a guard
        // — the same narrowing 'if (h == null) { return }' gives, said in one line.
        fun narrowing() {
            box: Box? = Box(4)
            nya box != null
            println(box.value)               // Should print '4', with no '?.' needed
        }

        // A failure block replaces the throw: the reader has said what a false condition means, so
        // the block runs and the statement after the check runs too. This is what stands in for the
        // 'try'/'catch' a language with exceptions would reach for.
        fun recovered() {
            nya 1 == 2 {
                println("handled: 1 == 2 was false")
            }
            println("recovered")             // Should print 'recovered'
        }

        // The same block answers a check that failed somewhere else. `guarded` ends in a bare 'nya'
        // of its own, which throws — and the block catches it rather than letting it unwind the
        // caller, so a failed check inside a function is handled where the call was made. Nothing
        // here names the error: what the block describes is the failure, not the object carrying it.
        fun catching() {
            nya guarded() {
                println("caught: the check inside guarded failed")
            }
            println("continued")             // Should print 'continued'
        }

        fun guarded() {
            nya 1 == 2
        }

        // With both blocks the construct is worth a value: each block says what it is worth on its own
        // reading of the condition, and the two answers have to agree in type. Here the blocks are the
        // two possible answers to "did these agree?", so the expression is a whole answer by itself.
        fun valued() {
            println(difference(1, 1))        // Should print '0'
            println(difference(1, 2))        // Should print '1'
        }

        fun difference(a: int, b: int): int {
            // The failure block is the reading where the condition did not hold, so it is the one that
            // answers "they differ"; 'else' is the reading where it did, and answers "they match".
            return nya a == b {
                yield 1
            } else {
                yield 0
            }
        }

        fun ready(): bool {
            return true
        }
    }
}

class Box {
    val value: int

    constructor(value: int) {
        this.value = value
    }
}
