locate com.github.kusa233.sample

class Sample {
    private val field1: int = 123

    fun main(args: string[]) {
        println(field1) // Should print '123'
        variable()
        lambda: int = lambda()(1,2) // Result should be 3.
    }

    fun variable() {
        str: string = "Hell world!"
        println(str)
        // Error to compile:
        // str: string = "new value"

        // Successes to compile:
        str = "new value"
        println(str)
    }

    fun lambda(): [int, int] -> int {
        return { x, y ->
            yield x + y
        }
    }
}
